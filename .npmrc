# Dependencies may not run arbitrary code at install time.
#
# A postinstall runs with the developer's (or CI's) full privileges the moment a
# package lands — the standard supply-chain foothold, and a common finding in
# supply-chain security review.
#
# npm's ignore-scripts is ALL-OR-NOTHING; there is no per-package allowlist.
# One package here declares a postinstall — esbuild — and it ships its native
# binary as a per-platform optionalDependency that npm installs normally, so the
# postinstall only selects one. Measured with a cold
# `rm -rf node_modules && npm ci && npm run build`, not assumed.
#
# ⚠️ PUBLISH TRAP, relevant because this package IS published to npm:
# ignore-scripts also suppresses `prepare`, `prepack` and `prepublishOnly`. There
# are none today, so nothing is lost — but adding
# `"prepublishOnly": "npm run build"` later would be SILENTLY skipped and would
# publish whatever stale dist/ happened to be on disk, with no error. If a
# build-on-publish hook is ever wanted, invoke it explicitly from the release
# step rather than relying on the lifecycle. (This file is not itself published:
# it is absent from "files", and npm excludes .npmrc from tarballs regardless.)
#
# ignore-scripts also suppresses `pre<event>`/`post<event>` for plain
# `npm run` — verified, and it fails silently when it does. There are no
# pre*/post* scripts here; do not add one and expect it to fire.
#
# If a future dependency genuinely needs its install script: `npm rebuild <pkg>`
# alone will NOT work, because npm rebuild honours ignore-scripts too and still
# reports success. The override is `npm rebuild <pkg> --ignore-scripts=false`.
# Never drop this setting to fix such a case.
ignore-scripts=true
