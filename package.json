{
  "name": "@kastra_labs/openclaw",
  "version": "0.2.0",
  "type": "module",
  "description": "Kastra AI governance for OpenClaw — policy-enforced tool calls with human-in-the-loop holds",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "test:integration": "npm run build && node scripts/test-integration.mjs",
    "smoke": "npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.9.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  }
}
